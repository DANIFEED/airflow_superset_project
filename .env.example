# =============================================================================
# PostgreSQL Configuration
# =============================================================================
DB_USER=bank_admin
DB_PASSWORD=your_password_here
DB_NAME=bank_analytics
POSTGRES_PORT=5432

# =============================================================================
# Airflow Configuration
# =============================================================================
# Сгенерировать командой:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=YourFernetKeyHere_44CharactersLongString!!
AIRFLOW_SECRET_KEY=YourAirflowWebSecretKeyHere
AIRFLOW_UID=50000

# =============================================================================
# Superset Configuration
# =============================================================================
# Сгенерировать командой:
# python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=YourSupersetSecretKeyHere
SUPERSET_PORT=8088

# =============================================================================
# AWS S3 Configuration (для Airflow DAG)
# =============================================================================
AWS_ACCESS_KEY_ID=YourAWSAccessKey
AWS_SECRET_ACCESS_KEY=YourAWSSecretKey

# =============================================================================
# Additional Python Packages for Airflow
# =============================================================================
_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-amazon apache-airflow-providers-postgres pandas sqlalchemy